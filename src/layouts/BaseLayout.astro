---
import '../styles/global.css';
import { sitePath } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dios Yang',
  description = 'The personal website of Yichi (Dios) Yang.',
} = Astro.props;

const path = Astro.url.pathname;
const links = [
  { href: '/about/', label: 'About' },
  { href: '/career/', label: 'Career' },
  { href: '/project/', label: 'Project' },
  { href: '/cv-resume/', label: 'CV/Resume' },
  { href: '/photography/', label: 'Photography' },
];
const active = (href: string) => href === '/about/'
  ? path === sitePath('/') || path.startsWith(sitePath(href))
  : path.startsWith(sitePath(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" href={sitePath('/favicon-cat.png')} type="image/png" sizes="300x300" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <aside class="sidebar" aria-label="Site navigation">
        <div class="sidebar-inner">
          <a class="site-title" href={sitePath('/')}>Dios Yang</a>
          <nav class="side-nav" aria-label="Main navigation">
            {links.map((link) => <a href={sitePath(link.href)} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
          </nav>
          <div class="social-marks" aria-hidden="true"><span>𝕏</span><span>f</span><span>◎</span></div>
          <details class="mobile-menu">
            <summary>Menu</summary>
            <nav aria-label="Mobile navigation">
              {links.map((link) => <a href={sitePath(link.href)} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
            </nav>
          </details>
        </div>
      </aside>
      <div class="site-main-column">
        <main id="main-content" class="site-main"><div class="content"><slot /></div></main>
        <footer class="site-footer">© {new Date().getFullYear()} Yichi (Dios) Yang</footer>
      </div>
    </div>
  </body>
</html>
