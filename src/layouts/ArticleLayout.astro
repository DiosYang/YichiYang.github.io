---
import { sitePath } from '../lib/paths';
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} — Dios Yang`} description={frontmatter.description}>
  <section class="article-head wrap">
    <a class="back-link" href={sitePath('/project/')}>← All projects</a>
    <p class="eyebrow">Research / Project</p>
    <h1>{frontmatter.title}</h1>
    <p class="article-dek">{frontmatter.description}</p>
  </section>
  <div class="article-divider wrap"></div>
  <article class="article-body wrap prose"><slot /></article>
  <section class="article-end wrap"><a class="text-link" href={sitePath('/project/')}>Explore all projects <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
