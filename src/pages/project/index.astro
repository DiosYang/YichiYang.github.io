---
import { sitePath } from '../../lib/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
---
<BaseLayout title="Projects — Dios Yang" description="Research and projects by Yichi (Dios) Yang across data science, statistics, and machine learning.">
  <section class="page-head wrap"><p class="eyebrow">Research / Selected projects</p><h1>Following the <em>question.</em></h1><p>My work moves between data, models, and the people or systems they help us understand.</p></section>
  <section class="project-list wrap" aria-label="Projects">
    {projects.map((project) => <a class="project-row" href={sitePath(`/${project.slug}/`)}>
      <span class="project-row-number">{project.number}</span>
      <div><span class="project-row-area">{project.area}</span><h2>{project.title}</h2><p>{project.description}</p></div>
      <span class="project-row-arrow" aria-hidden="true">↗</span>
    </a>)}
  </section>
</BaseLayout>
