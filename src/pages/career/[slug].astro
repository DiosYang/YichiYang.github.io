---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../lib/paths';
import { career } from '../../data/career';

export function getStaticPaths() {
  return career.map((entry) => ({ params: { slug: entry.frontmatter.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, dates, role } = entry.frontmatter;
const Content = entry.Content;
---
<BaseLayout title={`${title} — Career — Dios Yang`} description={`${role} at ${title}.`}>
  <a class="simple-back" href={sitePath('/career/')}>← Career</a>
  <header class="career-detail-header">
    <h1 class="page-title">{title}</h1>
    <span class="career-dates">{dates}</span>
    <p>{role}</p>
  </header>
  <article class="article-body career-detail"><Content /></article>
  <a class="simple-back" href={sitePath('/career/')}>← Career</a>
</BaseLayout>
