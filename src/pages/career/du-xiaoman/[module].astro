---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { sitePath } from '../../../lib/paths';
import { careerModules } from '../../../data/career-modules';

export function getStaticPaths() {
  return careerModules.map((entry) => ({ params: { module: entry.frontmatter.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, summary } = entry.frontmatter;
const Content = entry.Content;
const headings = entry.getHeadings().filter((heading) => heading.depth === 2);
---
<BaseLayout title={`${title} — Du Xiaoman — Dios Yang`} description={summary}>
  <a class="simple-back" href={sitePath('/career/du-xiaoman/')}>← Du Xiaoman experience</a>
  <header class="career-detail-header">
    <p class="career-module-context">Du Xiaoman Technology (Beijing) Co., Ltd.</p>
    <h1 class="page-title">{title}</h1>
  </header>
  <section class="career-module-summary" aria-labelledby="summary">
    <h2 id="summary">Summary</h2>
    <p>{summary}</p>
  </section>
  <nav class="career-module-toc" aria-label="On this page">
    <h2>On this page</h2>
    <ul>{headings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
  </nav>
  <article class="article-body career-detail career-module-detail"><Content /></article>
  <a class="simple-back" href={sitePath('/career/du-xiaoman/')}>← All Du Xiaoman experience</a>
</BaseLayout>
