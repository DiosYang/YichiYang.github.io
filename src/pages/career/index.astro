---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../lib/paths';
import { career } from '../../data/career';
---
<BaseLayout title="Career — Dios Yang" description="Professional experience of Yichi (Dios) Yang.">
  <h1 class="page-title">Career</h1>
  <div class="career-list" aria-label="Professional experience">
    {career.map(({ frontmatter: entry }) => <a class="career-entry" href={sitePath(`/career/${entry.slug}/`)}>
      <span class="career-dates">{entry.dates}</span>
      <h2>{entry.title}</h2>
      <p>{entry.role}</p>
      <span class="career-read-more">Read experience →</span>
    </a>)}
  </div>
</BaseLayout>
