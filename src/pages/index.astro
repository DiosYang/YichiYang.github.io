---
import { sitePath } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const featured = projects.slice(0, 3);
---
<BaseLayout>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span> Portfolio of Yichi (Dios) Yang</p>
      <h1>Finding patterns<br />in <em>data.</em><br />Framing moments<br />in <em>life.</em></h1>
      <p class="hero-intro">I’m a machine learning engineer and data scientist drawn to the stories hidden in data—and to the quiet details photography helps us notice.</p>
      <div class="hero-actions">
        <a class="button button-dark" href={sitePath('/project/')}>Explore my work <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={sitePath('/about/')}>Get to know me <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-footnote"><span>01 / Research</span><span>02 / Photography</span><span>03 / Curiosity</span></div>
    </div>
    <div class="hero-visual">
      <img src={sitePath('/media/photo-05.jpg')} alt="Snowy mountain emerging through clouds, photographed by Dios Yang" fetchpriority="high" />
      <div class="hero-visual-caption"><span>Through another lens</span><span>Photography by Dios Yang</span></div>
    </div>
  </section>

  <section class="intro-band">
    <div class="wrap intro-band-inner">
      <p class="eyebrow">The lens I bring</p>
      <p>Curiosity connects my work in <strong>statistics, machine learning, and photography</strong>—each a way to look closer and understand more.</p>
      <span class="asterisk" aria-hidden="true">✳</span>
    </div>
  </section>

  <section class="section wrap" id="selected-work">
    <div class="section-heading">
      <div><p class="eyebrow">01 / Selected work</p><h2>Questions worth<br /><em>exploring.</em></h2></div>
      <a class="text-link" href={sitePath('/project/')}>All projects <span aria-hidden="true">↗</span></a>
    </div>
    <div class="project-grid">
      {featured.map((project) => <a class="project-card" href={sitePath(`/${project.slug}/`)}>
        <div class="project-card-top"><span>{project.number} / {project.area}</span><span aria-hidden="true">↗</span></div>
        <div><h3>{project.title}</h3><p>{project.description}</p></div>
        <span class="project-card-cta">{project.complete ? 'Read the project' : 'View project page'} <span aria-hidden="true">→</span></span>
      </a>)}
    </div>
  </section>

  <section class="photo-feature">
    <div class="wrap photo-feature-inner">
      <div class="photo-feature-copy">
        <p class="eyebrow">02 / Photography</p>
        <h2>There is always<br />more to <em>see.</em></h2>
        <p>Outside the data, I collect moments: a shift in the light, the rhythm of a city, and the stillness in between.</p>
        <a class="button button-light" href={sitePath('/photography/')}>View photographs <span aria-hidden="true">↗</span></a>
      </div>
      <div class="photo-feature-images">
        <img src={sitePath('/media/photo-06.jpg')} alt="Sunlight and smoke around a traditional roof" loading="lazy" />
        <img src={sitePath('/media/photo-02.jpg')} alt="City skyline along a river" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="about-teaser wrap section">
    <div><p class="eyebrow">03 / About me</p><h2>A mind for models.<br /><em>An eye for moments.</em></h2></div>
    <div class="about-teaser-copy"><p>With a background in mathematics, economics, and statistics, I work across data exploration, model interpretability, and end-to-end machine learning pipelines.</p><p>I studied at New York University and Columbia University. I’m interested in what variables reveal when we look beyond prediction and ask why.</p><a class="text-link" href={sitePath('/about/')}>More about me <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>
