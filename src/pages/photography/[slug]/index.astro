---
import { sitePath } from '../../../lib/paths';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { albums } from '../../../data/albums';

export function getStaticPaths() {
  return albums.map((album) => ({ params: { slug: album.slug }, props: { album } }));
}

const { album } = Astro.props;
---
<BaseLayout title={`${album.title} — Photography — Dios Yang`} description={album.note}>
  <h1 class="page-title">{album.title}</h1>
  <a class="simple-back" href={sitePath('/photography/')}>← Photography</a>
  <div class="album-photos" aria-label={`${album.title} photographs`}>
    {album.photos.map((photo, index) => <figure>
      <a href={sitePath(photo.src)} target="_blank" rel="noopener" aria-label={`Open full photograph: ${photo.caption}`}>
        <img src={sitePath(photo.src)} alt={photo.alt} loading={index === 0 ? 'eager' : 'lazy'} />
      </a>
    </figure>)}
  </div>
</BaseLayout>
