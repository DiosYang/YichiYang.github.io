---
import { sitePath } from '../../lib/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { albums } from '../../data/albums';
---
<BaseLayout title="Photography — Dios Yang" description="Photography by Yichi (Dios) Yang.">
  <h1 class="page-title">Photography</h1>
  <div class="photo-grid" aria-label="Photography collections">
    {albums.map((album, index) => <a class="photo-cover" href={sitePath(`/photography/${album.slug}/`)} aria-label={`${album.title}, ${album.photos.length} ${album.photos.length === 1 ? 'photo' : 'photos'}`}>
      <img src={sitePath(album.photos[0].src)} alt={album.photos[0].alt} loading={index < 3 ? 'eager' : 'lazy'} />
    </a>)}
  </div>
</BaseLayout>
